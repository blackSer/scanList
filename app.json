{
  "expo": {
    "name": "scanList",
    "slug": "scanList",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/escaneo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
